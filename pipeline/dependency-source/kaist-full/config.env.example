# kaist_pipeline 설정 파일.
# 이 파일을 config.env 로 복사한 뒤 아래 경로를 실제 환경에 맞게 채우세요.
#   cp config.env.example config.env
# bin/kp 가 실행될 때마다 이 파일을 읽어 모든 단계에 전달합니다.
# (다른 위치의 파일을 쓰려면: KP_CONFIG=/path/to/config.env bin/kp ...)

# ---- Python 인터프리터 (환경 3개, README "필요 환경" 참고) -----------------------
# phystwin : 전처리, CoTracker, TRELLIS, 3D 재구성, 납품 패키징 (Python 3.10)
KP_PY_PHYSTWIN=/path/to/envs/phystwin/bin/python
# sam3     : SAM 3.1 세그멘테이션 (Python 3.12)
KP_PY_SAM3=/path/to/envs/sam3/bin/python
# hamba    : HaMBA 손 복원 + MANO 시간축 피팅 (Python 3.10)
KP_PY_HAMBA=/path/to/envs/hamba/bin/python

# (선택) 납품 메타데이터 xlsx 를 쓸 python (openpyxl 필요). 비우면 KP_PY_PHYSTWIN 사용
KP_PY_XLSX=

# ---- 데이터 ---------------------------------------------------------------------
# 에피소드 케이스 폴더들과 episodes.json 이 있는 디렉터리 (절대경로 권장)
KP_DATA_BASE=/path/to/data
# episodes.json 을 다른 곳에 두려면 지정 (기본: $KP_DATA_BASE/episodes.json)
# EPISODES_JSON=/path/to/episodes.json

# ---- 외부 저장소 / 캐시 -------------------------------------------------------------
# git clone https://github.com/facebookresearch/co-tracker (가중치는 첫 실행 때 자동 다운로드)
KP_COTRACKER_REPO=/path/to/co-tracker
# Hugging Face 캐시. SAM 3.1(facebook/sam3.1, 접근 승인 필요)과 TRELLIS 가중치가 여기에 받아집니다.
# 먼저 `huggingface-cli login` 으로 승인된 계정 토큰을 등록하세요.
HF_HOME=/path/to/hf-cache

# ---- 로그 -----------------------------------------------------------------------
KP_LOG_DIR=/path/to/logs

# ---- (선택) 마스크 검수 편집기 ----------------------------------------------------
# data_process/sam_mask_refine.py 가 쓰는 facebook/sam3 체크포인트 파일 경로 (GUI 필요)
KP_SAM3_CKPT=
