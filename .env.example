# setup.sh가 처음 실행될 때 이 파일을 .env로 복사하고 빈 값을 자동으로 채웁니다.
# 직접 바꿔도 되는 값은 PC_LABEL, NAS_*, WORKER_*, 포트입니다. 바꾼 뒤 ./setup.sh를 다시 실행하세요.

# 화면에 표시될 이 PC의 이름 (비우면 "호스트이름 · GPU이름")
PC_LABEL=

# NAS: 이 PC에 NFS로 마운트된 위치 (마운트 지점 자체여야 합니다)
NAS_MOUNT=/mnt/kaist-data
# NAS 안의 RAW 폴더 (UI의 RAW 목록·미리보기에 사용)
NAS_RAW_HOST_PATH=/mnt/kaist-data/rgbd_raw

# 이 PC에서 실행 중인 GPU Worker
WORKER_URL=http://127.0.0.1:8090
WORKER_SECRET_FILE=/home/cw-wfm/Desktop/worker1/airflow/worker/secret

# 포트 (host 네트워크)
UI_PORT=18083
AIRFLOW_PORT=18082
POSTGRES_PORT=15432
# 다른 PC에서 접속을 막으려면 127.0.0.1로 바꿉니다.
UI_BIND=0.0.0.0
AIRFLOW_BIND=0.0.0.0

# ---- 아래는 setup.sh가 자동으로 채웁니다 ----
HOST_UID=
HOST_IP=
POSTGRES_PASSWORD=
AIRFLOW_JWT_SECRET=
KAIST_UI_ALLOWED_HOSTS=
KAIST_AIRFLOW_PUBLIC_URL=
