# ./start.sh가 .env를 생성합니다. 빈 값은 실행 시 채웁니다.
PC_ID=pc1
PC_LABEL=
HOST_UID=
HOST_IP=
COMPOSE_PROJECT_NAME=kaist-pc
STACK_STATE_DIR=.

NAS_MOUNT=/mnt/kaist-data
NAS_RAW_HOST_PATH=/mnt/kaist-data/rgbd_raw
NAS_GID=65536
GPU_PROJECT_DIR=
GPU_STATE_DIR=./gpu_state
GPU_LOCK_FILE=
KAIST_WEIGHTS_ROOT=
TORCH_CUDA_ARCH_LIST=

UI_PORT=18083
AIRFLOW_PORT=18082
GPU_WORKER_PORT=8090
POSTGRES_PORT=15432
AIRFLOW_LOG_PORT=18793
AIRFLOW_TRIGGER_LOG_PORT=18794
UI_BIND=0.0.0.0
AIRFLOW_BIND=0.0.0.0

# 시작 스크립트가 GPU Worker 포트·상태 경로에 맞춰 함께 설정합니다.
WORKER_URL=
WORKER_SECRET_FILE=
KAIST_UI_ALLOWED_HOSTS=
KAIST_AIRFLOW_PUBLIC_URL=
POSTGRES_PASSWORD=
AIRFLOW_JWT_SECRET=

# --weight 이름=경로로 개별 지정할 때 자동 기록됩니다 (비우면 공통 폴더 사용).
WEIGHT_HF_HUB=
WEIGHT_TORCH_HUB=
WEIGHT_VITDET=
WEIGHT_MANO=
WEIGHT_MANO_MEAN=
WEIGHT_VITPOSE=
WEIGHT_HAMBA=
WEIGHT_SUPERGLUE=
WEIGHT_MANO_FACES=
WEIGHT_MANO_FACES_MONO=
