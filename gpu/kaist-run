#!/usr/bin/env bash
# 호스트에서 한 번에 실행: SAM3 → 추적 → 3D 복원 → HaMBA·MANO → NAS 저장
#   gpu/kaist-run ep_20261112_062904 --prompt "white towel"
#   gpu/kaist-run ep_20261112_062904 --resume [--wait]
# 실행 중인 gpu-worker 컨테이너 안에서 돌립니다. 터미널을 닫아도 진행 중인 단계는 계속되며,
# 같은 명령에 --resume을 붙이면 다시 이어서 지켜볼 수 있습니다.
set -euo pipefail
cd "$(dirname "$0")/.."
if docker compose --profile gpu ps --status running -q gpu-worker 2>/dev/null | grep -q .; then
  exec docker compose --profile gpu exec gpu-worker /opt/kaist/entrypoint.sh run "$@"
fi
echo "gpu-worker 컨테이너가 실행 중이 아닙니다. gpu/setup_gpu.sh로 먼저 실행하세요." >&2
exit 1
